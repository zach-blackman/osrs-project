# Copy to .env on the VPS and fill in real values. Never commit .env.

POSTGRES_USER=merch
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=merch

# Required: shared clan login + session HMAC key (sessions survive password changes).
CLAN_PASSWORD=change-me-clan-password
SECRET_KEY=change-me-long-random-hex

# Wiki User-Agent — keep the custom value the wiki already knows.
UA=merch-scanner - nekrosisx

FAST_SCAN=1
SCAN_INTERVAL_MIN=10
# Leave 0 until backfill_history.py finishes, then set to 1 (or trigger a manual refresh).
SCAN_ON_STARTUP=0

REFERENCE_BANKROLL=50m
GLOBAL_FLOOR=100k
DEFAULT_CAPITAL=700m
DEFAULT_FLOOR=500k
DEFAULT_NATURE_COST=100
