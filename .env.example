# Copy to .env on the VPS and fill in real values. Never commit .env.

POSTGRES_USER=merch
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=merch

# Session signing (required whenever Discord or invites are enabled).
SECRET_KEY=change-me-long-random-hex

# Auth — Discord as identity provider and/or admin invites. No shared clan password.
INVITES_ENABLED=1

# Discord OAuth (https://discord.com/developers/applications)
# Create an app → OAuth2 → add redirect → copy client id/secret.
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_REDIRECT_URI=https://scan.wiseoldtools.com/auth/discord/callback
# Optional: make this Discord user admin on first login
# BOOTSTRAP_ADMIN_DISCORD_ID=
# BOOTSTRAP_ADMIN_USERNAME=admin

# Achievements mirror (Clan Community webhook — unrelated to login)
# DISCORD_ACHIEVEMENTS_WEBHOOK_URL=

# Wiki User-Agent — keep the custom value the wiki already knows.
UA=merch-scanner - nekrosisx

FAST_SCAN=1
SCAN_INTERVAL_MIN=10
# Leave 0 until backfill_history.py finishes, then set to 1 (or trigger a manual refresh).
SCAN_ON_STARTUP=0

REFERENCE_BANKROLL=50m
GLOBAL_FLOOR=100k
DEFAULT_CAPITAL=700m
DEFAULT_FLOOR=500k
DEFAULT_NATURE_COST=100
